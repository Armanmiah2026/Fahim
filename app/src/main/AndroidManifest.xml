<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" 
     
    package="app.dev.shapla.vpn">
    
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_CREDENTIALS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <application 
        android:allowBackup="false" 
        android:icon="@drawable/ic_app_icon" 
        android:label="SHAPLA FAST NET"
        android:name="renz.javacodez.vpn.activities.OpenVPNApplication"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme">
        <uses-library 
            android:name="org.apache.http.legacy" 
            android:required="false" />
        <service android:name="renz.javacodez.vpn.service.OpenVPNService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <service
            android:name="renz.javacodez.vpn.service.InjectorService"
            android:exported="true"/>
        <activity
            android:windowSoftInputMode="stateHidden|adjustPan"
            android:name="renz.javacodez.vpn.activities.OpenVPNClient"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

		<activity
            android:windowSoftInputMode="stateHidden|adjustPan"
            android:name="renz.javacodez.vpn.activities.SelectNetworkActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="true"/>
        <receiver android:name="net.openvpn.openvpn.OpenVPNRebootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        
        <activity android:name="renz.javacodez.vpn.activities.OpenVPNPrefs"
            android:exported="true"/>
        <activity android:name="renz.javacodez.vpn.activities.FileDialog" android:exported="true"/>
        <activity android:name="renz.javacodez.vpn.activities.OpenVPNAbout" android:exported="true"/>
        <activity android:exported="true" 
            android:name="renz.javacodez.vpn.activities.OpenVPNDisconnect"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity
            android:name="renz.javacodez.vpn.activities.LogActivity"
            android:label="Logs"
            android:parentActivityName="renz.javacodez.vpn.activities.OpenVPNClient"
            android:exported="true"/>
            <activity
                android:name="renz.javacodez.vpn.activities.ExceptionActivity"
                android:label="Application Error"
                android:exported="true"/>
        <activity
            android:name="renz.javacodez.vpn.activities.ResellerPanelActivity"
            android:label="Panel"
            android:parentActivityName="renz.javacodez.vpn.activities.OpenVPNClient"
            android:exported="true"/>
    </application>
</manifest>

